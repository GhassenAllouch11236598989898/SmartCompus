# ============================================================================
# SmartCampus AI — variables d'environnement (copier en .env, ne JAMAIS commiter .env)
# Mots de passe : uniquement lettres/chiffres/_ (ils sont insérés dans des URL).
# ============================================================================

# --- PostgreSQL (docker compose) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser
POSTGRES_DB=smartcampus
POSTGRES_TEST_DB=smartcampus_test
POSTGRES_HOST_PORT=5434
POSTGRES_IMAGE_TAG=pg17
# Rôles à moindre privilège créés par docker/postgres/init/01-roles-and-databases.sh
SMARTCAMPUS_OWNER_PASSWORD=change_me_owner
SMARTCAMPUS_APP_PASSWORD=change_me_app
AI_READONLY_PASSWORD=change_me_ai

# --- API ---
API_HOST_PORT=8000
ENVIRONMENT=development
# Origines frontend autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000
# Secret JWT (>= 32 caractères aléatoires) : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_with_a_long_random_secret_value_48c
RUN_MIGRATIONS=true
RUN_SEED=true

# --- Exécution hors Docker (uvicorn / pytest / alembic depuis l'hôte) ---
DATABASE_URL=postgresql+psycopg://smartcampus_app:change_me_app@localhost:5434/smartcampus
MIGRATION_DATABASE_URL=postgresql+psycopg://smartcampus_owner:change_me_owner@localhost:5434/smartcampus
AI_READONLY_DATABASE_URL=postgresql+psycopg://ai_readonly:change_me_ai@localhost:5434/smartcampus
TEST_DATABASE_URL=postgresql+psycopg://smartcampus_app:change_me_app@localhost:5434/smartcampus_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://smartcampus_owner:change_me_owner@localhost:5434/smartcampus_test
TEST_AI_READONLY_DATABASE_URL=postgresql+psycopg://ai_readonly:change_me_ai@localhost:5434/smartcampus_test
